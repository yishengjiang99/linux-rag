# Linux RAG live helper config (paths and caps, not feature flags: every source stays on).
# Copied to /etc/linux-rag/live.env on first deploy only (0644, never overwritten).
# Defaults in code already match prod; unset or commented keys use those defaults.

# Cache and caps
RAG_LIVE_CACHE_TTL=30
RAG_LIVE_MAX_FILE_BYTES=200000
RAG_LIVE_MAX_TOTAL_BYTES=2000000
RAG_LIVE_TAIL_LINES=4000
RAG_LIVE_K=12

# Nginx logs
RAG_NGINX_ACCESS_LOG=/var/log/nginx/access.log
RAG_NGINX_ERROR_LOG=/var/log/nginx/error.log

# Extra log files to tail (comma-separated). auth.log is summarized as counts only
# (see RAG_AUTH_LOG) and is not tailed raw. The denylist still applies to every path.
RAG_LOG_PATHS=
RAG_AUTH_LOG=/var/log/auth.log

# Journal units to pull for the last hour (comma-separated), plus journalctl -p warning.
RAG_JOURNAL_UNITS=linux-rag,linux-rag-live,linux-rag-collect,nginx,mysql,mysqld,finalcut

# MySQL read-only status over the local unix socket (no TCP). Key NAMES say which
# keys to read from the configured app env file (host/user/password/database).
# The helper parses those keys in-process and never logs, prints, or returns their values.
# Cannot point at the composer env file or the linux-rag secrets file (refused before open).
# If you change the env file path and it lives under /home, also add a
# BindReadOnlyPaths= entry on linux-rag-live.service.
# RAG_MYSQL_ENV_FILE=/path/to/app.env
RAG_MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
RAG_MYSQL_KEY_HOST=MYSQL_HOST
RAG_MYSQL_KEY_USER=MYSQL_USER
RAG_MYSQL_KEY_PASSWORD=MYSQL_PASSWORD
RAG_MYSQL_KEY_DATABASE=MYSQL_DATABASE
