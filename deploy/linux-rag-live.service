[Unit]
Description=Linux RAG: on-demand redacted live reads of this server (admin ask path)
After=network-online.target

[Service]
User=root
Group=linux-rag
WorkingDirectory=/opt/linux-rag
EnvironmentFile=-/etc/linux-rag/live.env
EnvironmentFile=-/etc/linux-rag/mysql.env
ExecStart=/usr/bin/python3 -m rag.live --serve /run/linux-rag/live.sock
RuntimeDirectory=linux-rag
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
# Unix socket only: MySQL is reached via the local mysqld socket, not TCP.
# ss uses netlink. AF_INET/AF_INET6 are omitted on purpose.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
